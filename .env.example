# PostgreSQL Connection URL (e.g., postgresql://postgres:password@localhost:5432/parcelpilot)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parcelpilot

# Qdrant Vector Database URL and API Key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini API Key (Primary LLM & Embeddings)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Fallback LLM / OpenAI keys (optional)
LLM_API_KEY=
EMBEDDING_API_KEY=
